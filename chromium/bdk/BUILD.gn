# The BDK engine overlay. It is mounted at //bdk in the Chromium checkout by
# `chromium:build` (see tooling/README.md), together with the runtime core and
# the C ABI headers from packages/core under //bdk/core, and linked into the
# Mac framework by the first patch in chromium/patches.

import("//mojo/public/tools/bindings/mojom.gni")
import("//tools/typescript/webui_ts_library.gni")

config("core_config") {
  include_dirs = [
    "core/include",
    "core/generated",
    "core/runtime",
  ]
}

# The runtime core shared with the stub runtime (packages/core/runtime). It is
# BDK's portable C++, not Chromium code: it follows packages/core's own lint
# and style, so Chromium's style checks do not apply to it.
source_set("core") {
  sources = [
    "core/runtime/app_settings.cc",
    "core/runtime/automation.cc",
    "core/runtime/automation_internal.h",
    "core/runtime/automation_state.h",
    "core/runtime/broker.cc",
    "core/runtime/broker_args.cc",
    "core/runtime/broker_internal.h",
    "core/runtime/core.cc",
    "core/runtime/core_host.cc",
    "core/runtime/contents_commands.cc",
    "core/runtime/core_internal.h",
    "core/runtime/core_windows.cc",
    "core/runtime/extension_policy.cc",
    "core/runtime/extension_policy.h",
    "core/runtime/local_socket.h",
    "core/runtime/local_socket_posix.cc",
    "core/runtime/providers.cc",
    "core/runtime/providers_internal.h",
    "core/runtime/reputation_lists.cc",
    "core/runtime/routes.cc",
    "core/runtime/routes.h",
    "core/runtime/translation.cc",
    "core/runtime/ui_router.cc",
  ]
  public_configs = [ ":core_config" ]
  configs -= [
    "//build/config/clang:find_bad_constructs",
    "//build/config/clang:unsafe_buffers",
    "//build/config/compiler:chromium_code",
  ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
}

# The core's structs hold plain pointers (it is not Chromium code); engine
# files that include core_internal.h must not have the raw_ptr check applied to
# them.
config("core_raw_ptr_exclusion") {
  cflags = [
    "-Xclang",
    "-plugin-arg-raw-ptr-plugin",
    "-Xclang",
    "raw-ptr-exclude-path=" + rebase_path("core/", root_build_dir),
  ]
}

# The page broker an internal page reaches (engine/pages, T-WUI-04). The
# WebUI bindings are TypeScript; they are compiled and the JavaScript is
# embedded in the engine as a header, so the bundled-page data source serves
# bindings that always match the runtime (/@bdk/page_broker.mojom-webui.js).
mojom("page_broker_mojom") {
  sources = [ "engine/pages/page_broker.mojom" ]
  webui_module_path = "/@bdk"
}

webui_ts_library("page_broker_ts") {
  root_dir = "$root_gen_dir/bdk/engine/pages"
  out_dir = "$target_gen_dir/page_broker_tsc"
  in_files = [ "page_broker.mojom-webui.ts" ]
  deps = [ "//ui/webui/resources/mojo:build_ts" ]
  extra_deps = [ ":page_broker_mojom_ts__generator" ]
}

action("page_broker_js_header") {
  script = "build/embed_text.py"
  inputs = [ "$target_gen_dir/page_broker_tsc/page_broker.mojom-webui.js" ]
  outputs = [ "$target_gen_dir/engine/pages/page_broker_js.h" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    "kPageBrokerMojomWebUiJs",
  ]
  deps = [ ":page_broker_ts" ]
}

