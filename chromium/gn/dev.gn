# BDK development preset, copied to out/dev/args.gn by chromium:build.
# Every name below was checked against the sources at the pinned commit
# (see chromium/gn/README.md for where each is declared).

target_os = "mac"
target_cpu = "arm64"

# Optimised, not a component build (BDK links //bdk into the framework and
# the framework hides non-exported symbols only when it is not a component
# build), with DCHECKs on so engine mistakes fail loudly.
is_debug = false
is_component_build = false
dcheck_always_on = true

# Line tables only, enough for backtraces. Blink gets none to save disk.
symbol_level = 1
blink_symbol_level = 0

chrome_pgo_phase = 0

use_remoteexec = false
cc_wrapper = "env CCACHE_SLOPPINESS=time_macros ccache"
