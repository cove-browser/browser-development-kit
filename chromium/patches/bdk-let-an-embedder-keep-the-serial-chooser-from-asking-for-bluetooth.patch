From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BDK Patches <patches@bdk.invalid>
Date: Wed, 25 Nov 2026 21:56:26 -0800
Subject: [PATCH] bdk: let an embedder keep the serial chooser from asking for
 Bluetooth

The Web Serial chooser lists Bluetooth serial ports as well as wired ones,
and to find them it asks the device service for ports with
allow_bluetooth_system_prompt set, which opens the Bluetooth adapter. On
macOS a process that uses Bluetooth without NSBluetoothAlwaysUsageDescription
in its Info.plist is ended by the system (a TCC privacy violation). Chrome
declares the key; an application embedding Chromium may not, and then
navigator.serial.requestPort() ended the application (BDK task T-UIR-13,
found when the chooser became a request of BDK's).

Add embedder_serial_bluetooth.h, a small inline header with a flag an
embedder clears once before any page asks for a port (no new target, as
embedder_prompt_visibility.h), and check it in
SerialChooserController::GetDevices: when cleared, the chooser asks for
ports without the Bluetooth prompt, as getPorts() already does
(kAvoidBluetoothPromptInGetPorts), and a request for wireless ports only
finds none instead of opening the adapter. With the flag set (the default)
nothing changes. Only the one .cc and the new header are touched.

Used by: the BDK engine (//bdk/engine/ui_browser_dialogs.cc).
---
 .../ui/serial/embedder_serial_bluetooth.h     | 34 +++++++++++++++++++
 .../ui/serial/serial_chooser_controller.cc    |  9 ++++-
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/serial/embedder_serial_bluetooth.h b/chrome/browser/ui/serial/embedder_serial_bluetooth.h
new file mode 100644
index 0000000000000000000000000000000000000000..5283196944153b052cf7923c88d9d2f8d7898dd1
--- /dev/null
+++ b/chrome/browser/ui/serial/embedder_serial_bluetooth.h
@@ -0,0 +1,34 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SERIAL_EMBEDDER_SERIAL_BLUETOOTH_H_
+#define CHROME_BROWSER_UI_SERIAL_EMBEDDER_SERIAL_BLUETOOTH_H_
+
+// A hook for Chromium embedders whose application may not use Bluetooth. The
+// Web Serial chooser lists Bluetooth serial ports too, and asks the operating
+// system for Bluetooth access to find them; on macOS a process that uses
+// Bluetooth without declaring why (NSBluetoothAlwaysUsageDescription) is
+// ended. When an embedder clears this, the chooser lists only the ports it can
+// find without asking, as getPorts() does (kAvoidBluetoothPromptInGetPorts),
+// and a request for wireless ports only finds none. Only embedders clear it,
+// once, before any page asks for a port.
+namespace embedder_serial_bluetooth {
+
+inline bool& MayAskForBluetoothFlag() {
+  static bool may_ask = true;
+  return may_ask;
+}
+
+inline void SetMayAskForBluetooth(bool may_ask) {
+  MayAskForBluetoothFlag() = may_ask;
+}
+
+// Whether the serial chooser may ask the operating system for Bluetooth.
+inline bool MayAskForBluetooth() {
+  return MayAskForBluetoothFlag();
+}
+
+}  // namespace embedder_serial_bluetooth
+
+#endif  // CHROME_BROWSER_UI_SERIAL_EMBEDDER_SERIAL_BLUETOOTH_H_
diff --git a/chrome/browser/ui/serial/serial_chooser_controller.cc b/chrome/browser/ui/serial/serial_chooser_controller.cc
index 46a0429eae91c6a6105997da8deb821a76beb2b3..18ee6456d204d774197f85fb2eb5b6725c0c8705 100644
--- a/chrome/browser/ui/serial/serial_chooser_controller.cc
+++ b/chrome/browser/ui/serial/serial_chooser_controller.cc
@@ -18,6 +18,7 @@
 #include "chrome/browser/serial/serial_blocklist.h"
 #include "chrome/browser/serial/serial_chooser_context_factory.h"
 #include "chrome/browser/serial/serial_chooser_histograms.h"
+#include "chrome/browser/ui/serial/embedder_serial_bluetooth.h"
 #include "chrome/browser/ui/scoped_tabbed_browser_displayer.h"
 #include "chrome/common/url_constants.h"
 #include "chrome/grit/branded_strings.h"
@@ -139,6 +140,12 @@ const device::mojom::SerialPortInfo& SerialChooserController::GetPortForTest(
 
 void SerialChooserController::GetDevices() {
   CHECK(view());
+  const bool may_ask_for_bluetooth =
+      embedder_serial_bluetooth::MayAskForBluetooth();
+  if (IsWirelessSerialPortOnly() && !may_ask_for_bluetooth) {
+    view()->OnOptionsInitialized();
+    return;
+  }
   if (IsWirelessSerialPortOnly()) {
     if (!adapter_) {
       BluetoothAdapterFactory::Get()->GetAdapter(base::BindOnce(
@@ -171,7 +178,7 @@ void SerialChooserController::GetDevices() {
   }
 
   chooser_context_->GetPortManager()->GetDevices(
-      /*allow_bluetooth_system_prompt=*/true,
+      /*allow_bluetooth_system_prompt=*/may_ask_for_bluetooth,
       base::BindOnce(&SerialChooserController::OnGetDevices,
                      weak_factory_.GetWeakPtr()));
 }
