From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BDK Patches <patches@bdk.invalid>
Date: Sun, 22 Nov 2026 12:00:00 -0800
Subject: [PATCH] bdk: let an embedder present the credential manager prompts

navigator.credentials.get({password: true}) on a site with saved
passwords shows an account chooser, and the first choice is followed
by the auto sign-in notice. ManagePasswordsUIController makes both as
tab-modal views dialogs (CreateAccountChooserPromptView,
CreateAutoSigninPromptView). A BDK page is a tab of a Browser, so the
controller goes ahead, but its window is not a views widget: the
dialog's widget has no parent host and the process ends at a DCHECK in
native_widget_mac.mm. BDK shows both as native sheets of its own.

Add embedder_credential_manager_prompts.h, a small header with two
settable factories (inline, no new target), and ask them first in
CreateAccountChooser() and CreateAutoSigninPrompt(). The prompts they
make answer through Chrome's CredentialManagerDialogController, as
Chrome's views do, so the credential returned to the page and the
auto sign-in setting are Chrome's. With no factories Chrome is
unchanged. Only the controller's .cc and the new header change.

Used by: the BDK engine (//bdk/engine/services/password_prompts.cc).
---
 .../embedder_credential_manager_prompts.h     | 57 +++++++++++++++++++
 .../manage_passwords_ui_controller.cc         |  9 +++
 2 files changed, 66 insertions(+)

diff --git a/chrome/browser/ui/passwords/embedder_credential_manager_prompts.h b/chrome/browser/ui/passwords/embedder_credential_manager_prompts.h
new file mode 100644
index 0000000000000000000000000000000000000000..1573676a333c9ce633046c52262ee7f754a44872
--- /dev/null
+++ b/chrome/browser/ui/passwords/embedder_credential_manager_prompts.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_PASSWORDS_EMBEDDER_CREDENTIAL_MANAGER_PROMPTS_H_
+#define CHROME_BROWSER_UI_PASSWORDS_EMBEDDER_CREDENTIAL_MANAGER_PROMPTS_H_
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/passwords/password_dialog_prompts.h"
+
+class CredentialManagerDialogController;
+
+namespace content {
+class WebContents;
+}
+
+// A hook for Chromium embedders that show the Credential Management API's
+// prompts (the account chooser of navigator.credentials.get() and the
+// auto sign-in notice that follows the first choice) in UI of their own. When
+// factories are set, ManagePasswordsUIController uses the prompts they make
+// instead of the tab-modal views dialogs. Each prompt answers through the
+// controller it is given, as Chrome's do. With no factories Chrome is
+// unchanged. Only embedders set them, once, before any page loads.
+namespace embedder_credential_manager_prompts {
+
+using AccountChooserFactory =
+    base::RepeatingCallback<std::unique_ptr<AccountChooserPrompt>(
+        CredentialManagerDialogController* controller,
+        content::WebContents* web_contents)>;
+using AutoSigninFactory =
+    base::RepeatingCallback<std::unique_ptr<AutoSigninFirstRunPrompt>(
+        CredentialManagerDialogController* controller,
+        content::WebContents* web_contents)>;
+
+inline AccountChooserFactory& GetAccountChooserFactory() {
+  static base::NoDestructor<AccountChooserFactory> factory;
+  return *factory;
+}
+
+inline AutoSigninFactory& GetAutoSigninFactory() {
+  static base::NoDestructor<AutoSigninFactory> factory;
+  return *factory;
+}
+
+inline void SetFactories(AccountChooserFactory account_chooser,
+                         AutoSigninFactory auto_signin) {
+  GetAccountChooserFactory() = std::move(account_chooser);
+  GetAutoSigninFactory() = std::move(auto_signin);
+}
+
+}  // namespace embedder_credential_manager_prompts
+
+#endif  // CHROME_BROWSER_UI_PASSWORDS_EMBEDDER_CREDENTIAL_MANAGER_PROMPTS_H_
diff --git a/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc b/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
index 49ed2025c48d90ff0f2cba767ba883b4c87c6252..d8fa7fd49c37a74c8ed16b8619200183300a26ea 100644
--- a/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
+++ b/chrome/browser/ui/passwords/manage_passwords_ui_controller.cc
@@ -49,6 +49,7 @@
 #include "chrome/browser/ui/page_action/page_action_icon_type.h"
 #include "chrome/browser/ui/passwords/credential_leak_dialog_controller_impl.h"
 #include "chrome/browser/ui/passwords/credential_manager_dialog_controller_impl.h"
+#include "chrome/browser/ui/passwords/embedder_credential_manager_prompts.h"
 #include "chrome/browser/ui/passwords/manage_passwords_auto_signin_toast_delegate.h"
 #include "chrome/browser/ui/passwords/password_dialog_prompts.h"
 #include "chrome/browser/ui/passwords/passwords_leak_dialog_delegate.h"
@@ -1354,12 +1355,20 @@ void ManagePasswordsUIController::UpdatePasswordIconAndBubbleState(
 std::unique_ptr<AccountChooserPrompt>
 ManagePasswordsUIController::CreateAccountChooser(
     CredentialManagerDialogController* controller) {
+  if (const auto& factory = embedder_credential_manager_prompts::
+          GetAccountChooserFactory()) {
+    return factory.Run(controller, web_contents());
+  }
   return CreateAccountChooserPromptView(controller, web_contents());
 }
 
 std::unique_ptr<AutoSigninFirstRunPrompt>
 ManagePasswordsUIController::CreateAutoSigninPrompt(
     CredentialManagerDialogController* controller) {
+  if (const auto& factory =
+          embedder_credential_manager_prompts::GetAutoSigninFactory()) {
+    return factory.Run(controller, web_contents());
+  }
   return CreateAutoSigninPromptView(controller, web_contents());
 }
 
