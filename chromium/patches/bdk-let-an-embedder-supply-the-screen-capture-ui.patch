--- /dev/null
+++ b/chrome/browser/media/webrtc/embedder_screen_capture_ui.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_MEDIA_WEBRTC_EMBEDDER_SCREEN_CAPTURE_UI_H_
+#define CHROME_BROWSER_MEDIA_WEBRTC_EMBEDDER_SCREEN_CAPTURE_UI_H_
+
+#include <memory>
+#include <string>
+
+class DesktopMediaPicker;
+class MediaStreamUI;
+
+namespace content {
+struct DesktopMediaID;
+struct MediaStreamRequest;
+class WebContents;
+}  // namespace content
+
+// A hook for Chromium embedders whose windows are not views widgets. The
+// screen-capture source picker (getDisplayMedia, chrome.desktopCapture) and
+// the "sharing" notification (ScreenCaptureNotificationUI for a screen or a
+// window, TabSharingUI for a tab) are views UI; an embedder sets these
+// factories, once, before any page or extension asks to capture.
+// DesktopMediaPicker::Create returns the embedder's picker, and
+// GetDevicesForDesktopCapture asks the embedder for the notification of every
+// capture it would show one for. Everything else of Chrome's capture path (the
+// source lists, the access handler, the stream, the capture indicator) is
+// unchanged. With no factory set nothing changes.
+namespace embedder_screen_capture_ui {
+
+using PickerFactory = std::unique_ptr<DesktopMediaPicker> (*)(
+    const content::MediaStreamRequest* request);
+using NotificationFactory = std::unique_ptr<MediaStreamUI> (*)(
+    content::WebContents* capturing_web_contents,
+    const content::DesktopMediaID& captured,
+    const std::u16string& application_title);
+
+inline PickerFactory& PickerFactoryRef() {
+  static PickerFactory factory = nullptr;
+  return factory;
+}
+
+inline NotificationFactory& NotificationFactoryRef() {
+  static NotificationFactory factory = nullptr;
+  return factory;
+}
+
+inline void SetFactories(PickerFactory picker,
+                         NotificationFactory notification) {
+  PickerFactoryRef() = picker;
+  NotificationFactoryRef() = notification;
+}
+
+}  // namespace embedder_screen_capture_ui
+
+#endif  // CHROME_BROWSER_MEDIA_WEBRTC_EMBEDDER_SCREEN_CAPTURE_UI_H_
