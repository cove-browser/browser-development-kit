From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BDK Patches <patches@bdk.invalid>
Date: Fri, 20 Nov 2026 18:50:05 -0800
Subject: [PATCH] bdk: register an embedder's branded scheme in every process

A BDK application names its internal scheme (for example cove://) in its
configuration, read at start-up, so one prebuilt runtime serves every
application. The scheme is an alias: the engine rewrites cove://settings
to chrome://bdk-settings (or chrome://settings) on navigation and reports
the branded form back. For URLs of the scheme to parse the same way in
the browser and in renderers, the scheme must be registered as standard
in each process before the scheme registry is locked, and ContentClient's
AddAdditionalSchemes is the only place that runs early enough in child
processes. Child processes run Chrome's own ChromeMainDelegate and
ChromeContentClient, so no embedder subclass can add it there.

Read the scheme from the --bdk-internal-scheme switch, which the BDK
engine sets for the browser process and copies to every child in
ContentBrowserClient::AppendExtraCommandLineSwitches, and register it as
standard and secure only: no WebUI, CORS or CSP-bypassing privilege. With
no switch nothing changes, so Chrome is unchanged.

Used by: the BDK engine (//bdk/engine/chromium_main_mac.mm,
//bdk/engine/content_browser_client.cc, //bdk/engine/pages/).
---
 chrome/common/chrome_content_client.cc | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/chrome/common/chrome_content_client.cc b/chrome/common/chrome_content_client.cc
index 601ff3ce617e212d57e59aa24e023a8a506da6f9..2ad96fd87aa772041b7972ec24282c0fc0efb13b 100644
--- a/chrome/common/chrome_content_client.cc
+++ b/chrome/common/chrome_content_client.cc
@@ -12,6 +12,7 @@
 #include <utility>
 
 #include "base/check.h"
+#include "base/command_line.h"
 #include "base/containers/flat_set.h"
 #include "base/functional/bind.h"
 #include "base/json/json_reader.h"
@@ -206,6 +207,22 @@ void ChromeContentClient::AddAdditionalSchemes(Schemes* schemes) {
   for (auto* standard_scheme : kChromeStandardURLSchemes)
     schemes->standard_schemes.push_back(standard_scheme);
 
+  // BDK: the application's branded internal scheme, an alias that the
+  // embedder rewrites to chrome:// on navigation. It is named at start-up and
+  // passed to every child process, so it is registered the same way in each:
+  // standard and secure, with no WebUI, CORS or CSP privilege.
+  if (base::CommandLine::InitializedForCurrentProcess()) {
+    std::string bdk_scheme =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "bdk-internal-scheme");
+    if (!bdk_scheme.empty() && base::IsStringASCII(bdk_scheme) &&
+        base::ToLowerASCII(bdk_scheme) == bdk_scheme &&
+        base::IsAsciiAlpha(bdk_scheme[0])) {
+      schemes->standard_schemes.push_back(bdk_scheme);
+      schemes->secure_schemes.push_back(bdk_scheme);
+    }
+  }
+
 #if BUILDFLAG(IS_ANDROID)
   schemes->referrer_schemes.push_back(content::kAndroidAppScheme);
   schemes->referrer_schemes.push_back(dom_distiller::kDomDistillerScheme);
