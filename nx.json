{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.node-version"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "lintConfig": [
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/.swiftlint.yml",
      "{workspaceRoot}/.swift-format",
      "{workspaceRoot}/.clang-format",
      "{workspaceRoot}/.clang-tidy",
      "{workspaceRoot}/taplo.toml",
      "{workspaceRoot}/.editorconfig"
    ],
    "nativeToolchain": [
      {
        "runtime": "sh tooling/toolchain-id.sh"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    },
    "codegen": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "lintConfig"]
    },
    "format": {
      "cache": false
    },
    "runtime": {
      "cache": false
    },
    "sync": {
      "cache": false
    },
    "package": {
      "cache": false
    },
    "publish": {
      "cache": false
    }
  },
  "analytics": true
}
