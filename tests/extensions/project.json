{
  "name": "extensions-suite",
  "root": "tests/extensions",
  "projectType": "library",
  "implicitDependencies": ["tooling"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --root {projectRoot}"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["vitest"]
        },
        "{workspaceRoot}/docs/planning/sdk/extensions.md",
        "{workspaceRoot}/docs/extensions/**",
        "{workspaceRoot}/tooling/src/paths.ts",
        "{workspaceRoot}/tooling/src/runtime/cli.ts"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec biome check {projectRoot}",
          "pnpm exec tsc -p {projectRoot}/tsconfig.json"
        ],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome format --write {projectRoot}"
      }
    },
    "matrix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec tsx {projectRoot}/src/cli.ts generate"
      }
    },
    "matrix-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec tsx {projectRoot}/src/cli.ts check"
      }
    },
    "test-extensions": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec tsx {projectRoot}/src/run-engine.ts"
      }
    }
  }
}
