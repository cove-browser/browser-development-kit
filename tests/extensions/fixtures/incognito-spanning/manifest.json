{
  "manifest_version": 3,
  "name": "BDK Incognito Probe (spanning)",
  "version": "0.1.0",
  "description": "Test fixture: one worker serves regular and private windows (manifest incognito mode spanning).",
  "minimum_chrome_version": "127",
  "incognito": "spanning",
  "permissions": ["tabs", "storage"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] }
}
