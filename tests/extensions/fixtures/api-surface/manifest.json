{
  "manifest_version": 3,
  "name": "BDK API Surface Probe",
  "version": "0.1.0",
  "description": "Test fixture: asks for every desktop API permission in the compatibility matrix and reports which namespaces exist.",
  "minimum_chrome_version": "127",
  "permissions": [
    "alarms",
    "bookmarks",
    "browsingData",
    "contentSettings",
    "contextMenus",
    "cookies",
    "debugger",
    "declarativeNetRequest",
    "desktopCapture",
    "downloads",
    "fontSettings",
    "history",
    "identity",
    "management",
    "notifications",
    "offscreen",
    "privacy",
    "proxy",
    "scripting",
    "search",
    "sessions",
    "sidePanel",
    "storage",
    "tabCapture",
    "tabGroups",
    "tabs",
    "topSites",
    "tts",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "BDK API surface" },
  "commands": {
    "probe-command": {
      "suggested_key": { "default": "Ctrl+Shift+9", "mac": "Command+Shift+9" },
      "description": "Probe command"
    }
  },
  "omnibox": { "keyword": "bdkprobe" },
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] }
}
