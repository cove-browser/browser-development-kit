{
  "namespace": "contents",
  "since": 1,
  "types": {
    "SecurityLevel": {
      "enum": ["unknown", "none", "secure", "broken"]
    },
    "CreatorKind": {
      "enum": ["swift", "session"]
    },
    "ContentsInfo": {
      "id": "string",
      "url": "string",
      "title": "string",
      "profile": "string",
      "visible": "bool",
      "loading": "bool",
      "crashed": "bool"
    },
    "ContentsDetail": {
      "id": "string",
      "url": "string",
      "title": "string",
      "profile": "string",
      "visible": "bool",
      "loading": "bool",
      "crashed": "bool",
      "progress": "double",
      "security": "SecurityLevel",
      "audible": "bool",
      "muted": "bool",
      "focused": "bool",
      "zoom": "double",
      "canGoBack": "bool",
      "canGoForward": "bool"
    },
    "Creator": {
      "kind": "CreatorKind",
      "session": "string?"
    },
    "LoadCondition": {
      "enum": ["committed", "finished"]
    },
    "NavigationResult": {
      "url": "string",
      "errorPage": "bool"
    },
    "FrameInfo": {
      "id": "string",
      "parent": "string?",
      "url": "string",
      "origin": "string",
      "name": "string"
    },
    "Rect": {
      "x": "double",
      "y": "double",
      "width": "double",
      "height": "double"
    },
    "ElementInfo": {
      "tag": "string",
      "attributes": "json",
      "text": "string",
      "box": "Rect?"
    },
    "SnapshotKind": {
      "enum": ["dom", "accessibility", "text"]
    },
    "MouseButton": {
      "enum": ["left", "middle", "right"]
    },
    "ScreenshotArea": {
      "enum": ["visible", "fullPage", "rect"]
    },
    "ImageFormat": {
      "enum": ["png", "jpeg"]
    },
    "SaveFormat": {
      "enum": ["htmlOnly", "completePage", "singleFile"]
    },
    "Capture": {
      "mimeType": "string",
      "byteLength": "int",
      "path": "string?"
    }
  },
