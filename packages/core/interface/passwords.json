{
  "namespace": "passwords",
  "since": 1,
  "types": {
    "PasswordInfo": {
      "id": "string",
      "origin": "url",
      "username": "string",
      "created": "timestamp",
      "lastUsed": "timestamp?"
    },
    "PasswordIssue": {
      "id": "string",
      "origin": "url",
      "username": "string",
      "flagged": "timestamp",
      "dismissed": "bool"
    },
    "PasswordChange": {
      "enum": ["added", "updated", "removed"]
    }
  },
  "commands": [
    {
      "name": "passwords.list",
      "capability": "passwords.read",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {},
      "result": {
        "items": "PasswordInfo[]"
      }
    },
    {
      "name": "passwords.forOrigin",
      "capability": "passwords.read",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "origin": "url"
      },
      "result": {
        "items": "PasswordInfo[]"
      }
    },
    {
      "name": "passwords.reveal",
      "capability": "passwords.reveal",
      "callers": ["swift", "page"],
      "profile": "required",
      "requires": ["authentication"],
      "args": {
        "id": "string"
      },
      "result": {
        "password": "string"
      }
    },
    {
      "name": "passwords.add",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "origin": "url",
        "username": "string",
        "password": "string"
      },
      "result": "PasswordInfo"
    },
    {
      "name": "passwords.update",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "authenticateWhen": "password",
      "args": {
        "id": "string",
        "username": "string?",
        "password": "string?"
      },
      "result": "PasswordInfo"
    },
    {
      "name": "passwords.remove",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "id": "string"
      },
      "result": "void"
    },
    {
      "name": "passwords.neverSaved",
      "capability": "passwords.read",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {},
      "result": {
        "origins": "url[]"
      }
    },
    {
      "name": "passwords.removeNeverSaved",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "origin": "url"
      },
      "result": "void"
    },
    {
      "name": "passwords.export",
      "capability": "passwords.reveal",
      "callers": ["swift", "page"],
      "profile": "required",
      "requires": ["gesture", "authentication"],
      "args": {
        "path": "string"
      },
      "result": "void"
    },
    {
      "name": "passwords.import",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "path": "string"
      },
      "result": {
        "imported": "int"
      },
      "progress": true
    },
    {
      "name": "passwords.check",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "requires": ["authentication"],
      "args": {},
      "result": {
        "checked": "int",
        "flagged": "int"
      },
      "progress": true
    },
    {
      "name": "passwords.issues",
      "capability": "passwords.read",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {},
      "result": {
        "items": "PasswordIssue[]"
      }
    },
    {
      "name": "passwords.dismissIssue",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "id": "string"
      },
      "result": "void"
    },
    {
      "name": "passwords.restoreIssue",
      "capability": "passwords.manage",
      "callers": ["swift", "page", "session"],
      "profile": "required",
      "args": {
        "id": "string"
      },
      "result": "void"
    }
  ],
  "events": [
    {
      "name": "passwords.changed",
      "capability": "passwords.read",
      "payload": {
        "id": "string",
        "change": "PasswordChange",
        "source": "ChangeSource"
      }
    },
    {
      "name": "passwords.issuesChanged",
      "capability": "passwords.read",
      "payload": {}
    }
  ]
}
