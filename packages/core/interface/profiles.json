      "lastUsed": "timestamp?",
      "isPrivate": "bool"
    }
  },
  "commands": [
    {
      "name": "profiles.list",
      "capability": "profiles.read",
      "callers": ["swift", "page", "session"],
      "profile": "none",
      "args": {},
      "result": {
        "profiles": "ProfileInfo[]"
      }
    },
    {
      "name": "profiles.current",
      "capability": "profiles.read",
      "callers": ["swift", "page", "session"],
