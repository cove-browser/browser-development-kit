    },
    {
      "name": "profiles.create",
      "capability": "profiles.manage",
      "callers": ["swift", "page", "session"],
      "profile": "none",
      "args": {
        "name": "string"
      },
      "result": "ProfileInfo"
    },
    {
      "name": "profiles.rename",
      "capability": "profiles.manage",
      "callers": ["swift", "page", "session"],
      "profile": "none",
      "args": {
        "id": "string",
        "name": "string"
      },
      "result": "void"
    },
    {
