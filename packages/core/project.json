{
  "name": "core",
  "root": "packages/core",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "cmake -S packages/core -B packages/core/build -G Ninja",
          "cmake --build packages/core/build"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": ["ctest --test-dir packages/core/build --output-on-failure"],
        "parallel": false
      },
      "inputs": ["default", "nativeToolchain"],
      "dependsOn": ["build"]
    },
    "test-engine": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash packages/core/scripts/test-engine.sh"
      },
      "configurations": {
        "silent": {
          "env": { "BDK_ENGINE_SILENT": "1" }
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "sh -c \"git ls-files -z --cached --others --exclude-standard -- 'packages/core/*.h' 'packages/core/*.c' 'packages/core/*.cc' | xargs -0 clang-format --dry-run -Werror\"",
          "sh tooling/clang-tidy.sh packages/core/build packages/core"
        ],
        "parallel": false
      },
      "inputs": ["default", "lintConfig", "nativeToolchain"],
      "dependsOn": ["build"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c \"git ls-files -z --cached --others --exclude-standard -- 'packages/core/*.h' 'packages/core/*.c' 'packages/core/*.cc' | xargs -0 clang-format -i\""
      }
    }
  }
}
