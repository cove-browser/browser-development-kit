# The BDK ABI hash. See packages/core/docs/conventions.md, "The ABI hash".
#
#   cmake -P packages/core/cmake/abi-hash.cmake                   print the hash (64 hex digits) to stdout
#   cmake -DMODE=generate -P packages/core/cmake/abi-hash.cmake   rewrite packages/core/generated/
#   cmake -DMODE=check    -P packages/core/cmake/abi-hash.cmake   exit non-zero if generated/ is out of date
#
# Input: every packages/core/include/bdk/*.h and every packages/core/interface/*.json, sorted by path.
# Normalisation of each file: line endings to LF; for headers, /* ... */ comments removed; every run of
# whitespace (including newlines) becomes one space; leading and trailing whitespace removed. The digest is
# SHA-256 over the concatenation of "<path relative to packages/core>\n<normalised text>\n" for each file.
# Reformatting a header or editing a comment therefore does not change the hash; any change to a declaration,
# macro, type or interface definition does.
cmake_minimum_required(VERSION 3.20)

if(NOT MODE)
  set(MODE print)
endif()

get_filename_component(CORE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

file(GLOB headers RELATIVE "${CORE_DIR}" "${CORE_DIR}/include/bdk/*.h")
file(GLOB definitions RELATIVE "${CORE_DIR}" "${CORE_DIR}/interface/*.json")
list(SORT headers COMPARE STRING)
list(SORT definitions COMPARE STRING)
if(NOT headers)
  message(FATAL_ERROR "abi-hash: no headers found under ${CORE_DIR}/include/bdk")
endif()

set(record "")
foreach(file IN LISTS headers definitions)
  file(READ "${CORE_DIR}/${file}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  string(REPLACE "\r" "\n" text "${text}")
  if(file MATCHES "\\.h$")
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" text "${text}")
  endif()
  string(REGEX REPLACE "[ \t\n]+" " " text "${text}")
  string(STRIP "${text}" text)
  string(APPEND record "${file}\n${text}\n")
endforeach()
string(SHA256 hash "${record}")

set(header_text "/* Generated by packages/core/cmake/abi-hash.cmake. Do not edit. */\n#ifndef BDK_ABI_HASH_H_\n#define BDK_ABI_HASH_H_\n#define BDK_ABI_HASH \"${hash}\"\n#endif\n")
set(text_text "${hash}\n")
set(header_file "${CORE_DIR}/generated/bdk_abi_hash.h")
set(text_file "${CORE_DIR}/generated/abi-hash.txt")

function(bdk_read_or_empty path out)
  if(EXISTS "${path}")
    file(READ "${path}" content)
  else()
    set(content "")
  endif()
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "print")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${hash}")
elseif(MODE STREQUAL "generate")
  file(MAKE_DIRECTORY "${CORE_DIR}/generated")
  bdk_read_or_empty("${header_file}" old_header)
  bdk_read_or_empty("${text_file}" old_text)
  if(NOT old_header STREQUAL header_text)
    file(WRITE "${header_file}" "${header_text}")
  endif()
  if(NOT old_text STREQUAL text_text)
    file(WRITE "${text_file}" "${text_text}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${hash}")
elseif(MODE STREQUAL "check")
  bdk_read_or_empty("${header_file}" old_header)
  bdk_read_or_empty("${text_file}" old_text)
  if(NOT old_header STREQUAL header_text OR NOT old_text STREQUAL text_text)
    string(REGEX MATCH "BDK_ABI_HASH \"([0-9a-f]*)\"" ignored "${old_header}")
    message(FATAL_ERROR
      "ABI hash drift: the headers hash to ${hash} but packages/core/generated records "
      "'${CMAKE_MATCH_1}'.\nRegenerate with: cmake -DMODE=generate -P packages/core/cmake/abi-hash.cmake")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${hash}")
else()
  message(FATAL_ERROR "abi-hash: unknown MODE '${MODE}' (print, generate, check)")
endif()
