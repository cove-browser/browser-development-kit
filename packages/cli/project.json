{
  "name": "cli",
  "root": "packages/cli",
  "projectType": "library",
  "implicitDependencies": ["core", "js-codegen"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["js-codegen"],
          "target": "build"
        }
      ],
      "options": {
        "command": "pnpm exec tsc -p {projectRoot}/tsconfig.build.json"
      },
      "inputs": [
        "default",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --root {projectRoot}"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/tests/config/**/*",
        {
          "externalDependencies": ["vitest"]
        }
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec biome check {projectRoot} tests/config",
          "pnpm exec tsc -p {projectRoot}/tsconfig.json --noEmit",
          "pnpm exec tsc -p {projectRoot}/scripts/tsconfig.json --noEmit",
          "pnpm exec tsx {projectRoot}/scripts/check-config-assets.ts",
          "taplo format --check 'tests/config/valid/*.toml' 'tests/config/resolve/*/bdk.toml'"
        ],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome format --write {projectRoot}"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec tsx {projectRoot}/scripts/package.ts"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/.node-version",
        {
          "externalDependencies": ["rolldown"]
        }
      ],
      "outputs": ["{projectRoot}/dist/bdk", "{projectRoot}/dist/bdk.artifactbundle"]
    }
  }
}
