{
  "name": "js-codegen",
  "root": "packages/js/codegen",
  "projectType": "library",
  "implicitDependencies": ["js-protocol"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["js-protocol"], "target": "build" }],
      "options": { "command": "pnpm exec tsc -p {projectRoot}/tsconfig.build.json" },
      "inputs": ["default", { "externalDependencies": ["typescript"] }],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vitest run --root {projectRoot}" },
      "inputs": ["default", { "externalDependencies": ["vitest"] }]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec biome check {projectRoot}",
          "pnpm exec tsc -p {projectRoot}/tsconfig.json --noEmit"
        ],
        "parallel": false
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec biome format --write {projectRoot}" }
    }
  }
}
