{
  "name": "swift",
  "root": "packages/swift",
  "projectType": "library",
  "implicitDependencies": ["core", "chromium"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "swift build --package-path packages/swift" },
      "inputs": [
        "default",
        "nativeToolchain",
        "{workspaceRoot}/packages/core/include/**/*",
        { "dependentTasksOutputFiles": "**/runtime.json", "transitive": false },
        { "fileset": "{workspaceRoot}/.bdk/runtime.json" }
      ],
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "swift test --package-path packages/swift" },
      "inputs": [
        "default",
        "nativeToolchain",
        "{workspaceRoot}/packages/core/include/**/*",
        { "dependentTasksOutputFiles": "**/runtime.json", "transitive": false },
        { "fileset": "{workspaceRoot}/.bdk/runtime.json" }
      ]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "echo 'swift:test-integration: not implemented until M2 (needs a published runtime)'"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "swift format lint --strict --recursive packages/swift/Sources packages/swift/Tests packages/swift/Package.swift",
          "swiftlint lint --strict --config .swiftlint.yml packages/swift"
        ],
        "parallel": false
      },
      "inputs": ["default", "lintConfig", "nativeToolchain"]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "swift format --in-place --recursive packages/swift/Sources packages/swift/Tests packages/swift/Package.swift"
      }
    }
  }
}
